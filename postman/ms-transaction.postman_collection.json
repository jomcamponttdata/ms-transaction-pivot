              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Last page has one result and no continuation cursor', () => {",
              "    pm.expect(pm.response.json()).to.be.an('array').with.lengthOf(1);",
              "    pm.expect(pm.response.headers.get('X-Next-Cursor')).to.be.undefined;",
