    {
      "name": "05 - Find first cursor page",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Page has one result and a continuation cursor', () => {",
              "    const body = pm.response.json();",
              "    const cursor = pm.response.headers.get('X-Next-Cursor');",
              "    pm.expect(body).to.be.an('array').with.lengthOf(1);",
              "    pm.expect(cursor).to.be.a('string').and.not.empty;",
              "    pm.collectionVariables.set('nextCursor', cursor);",
              "});"
            ]
          }
        }
