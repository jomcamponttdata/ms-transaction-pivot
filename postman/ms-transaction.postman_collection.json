    {
      "name": "04 - Find movements by product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Both product movements are returned', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.be.an('array').with.lengthOf(2);",
              "    body.forEach(movement => pm.expect(movement.productId).to.equal(pm.variables.get('productId')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/movements?productId={{productId}}&productType=BANK_ACCOUNT&limit=20",
          "host": [
            "{{baseUrl}}"
