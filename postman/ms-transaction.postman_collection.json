            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Editable fields are replaced', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.equal(pm.collectionVariables.get('movementId'));",
              "    pm.expect(body.movementType).to.equal('PAYMENT');",
              "    pm.expect(body.amount).to.equal(10);",
              "    pm.expect(body.currency).to.equal('USD');",
              "    pm.expect(body.description).to.equal('Updated payment');",
              "});"
            ]
          }
        }
