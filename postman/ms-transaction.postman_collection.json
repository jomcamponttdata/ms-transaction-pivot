{
  "info": {
    "_postman_id": "51f73cbb-5a44-4ee3-8d8c-ebdc4d4242b4",
    "name": "ms-transaction - Part I",
    "description": "Executable CRUD, cursor pagination, validation and error tests for transaction-service. Run the requests in order with a running MongoDB instance and transaction-service on port 8084.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "exec": [
          "pm.collectionVariables.set('correlationId', pm.variables.replaceIn('{{$guid}}'));",
          "if (!pm.variables.get('productId')) {",
          "    pm.collectionVariables.set('productId', pm.variables.replaceIn('{{$guid}}'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Create movement",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Created movement matches the contract', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.be.a('string').and.not.empty;",
              "    pm.expect(body.productId).to.equal(pm.variables.get('productId'));",
              "    pm.expect(body.productType).to.equal('BANK_ACCOUNT');",
              "    pm.expect(body.movementType).to.equal('DEPOSIT');",
              "    pm.expect(body.amount).to.equal(25.5);",
              "    pm.expect(body.currency).to.equal('PEN');",
              "    pm.expect(body.description).to.equal('Cash deposit');",
              "    pm.expect(body.createdAt).to.be.a('string').and.not.empty;",
              "    pm.expect(pm.response.headers.get('Location')).to.equal('/api/v1/movements/' + body.id);",
              "    pm.collectionVariables.set('movementId', body.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"productType\": \"BANK_ACCOUNT\",\n  \"movementType\": \"DEPOSIT\",\n  \"amount\": 25.50,\n  \"currency\": \"PEN\",\n  \"description\": \"Cash deposit\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/movements",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "movements"
          ]
        }
      },
      "response": []
    },
